  "description": "KUBU line icons: one SVG sprite and the .icon classes, coloured with currentColor.",
  "license": "MIT",
  "author": "Khotso Tsoaela",
  "repository": { "type": "git", "url": "git+https://github.com/ktsoaela/KUBU.git", "directory": "kubu-framework/packages/icons" },
  "style": "dist/icons.min.css",
  "main": "dist/icons.min.css",
  "files": ["dist"],
  "keywords": ["css", "icons", "svg", "sprite", "kubu"],
