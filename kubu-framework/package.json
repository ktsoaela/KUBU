{
  "name": "kubu-css",
  "version": "2.0.0",
  "description": "KUBU: one CSS file for server-rendered HTML. Atomic Design, BEM, dark-first tokens, htmx-friendly.",
  "license": "MIT",
  "author": "Khotso Tsoaela",
  "homepage": "https://github.com/ktsoaela/KUBU#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktsoaela/KUBU.git",
    "directory": "kubu-framework"
  },
  "bugs": {
    "url": "https://github.com/ktsoaela/KUBU/issues"
  },
  "style": "dist/kubu.min.css",
  "main": "dist/kubu.min.css",
  "files": [
    "dist",
    "css",
    "packages",
    "styles.css",
    "img",
    "js/htmx.min.js",
    "!packages/*/dist",
    "!packages/*/node_modules"
  ],
  "keywords": [
    "css",
    "framework",
    "atomic-design",
    "bem",
    "dark-mode",
    "htmx"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pages": "node scripts/pages.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/pages.mjs --check && node scripts/smoke.mjs",
    "dev": "npx --yes http-server .. -p 8080 -c-1 -o /kubu-framework/pages/index.html",
    "demo": "node demo/server.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.6.5",
    "browserslist": "^4.24.0",
    "lightningcss": "^1.29.0",
    "playwright-core": "^1.64.1",
    "storybook": "^10.6.5",
    "vite": "^8.3.5"
  }
}
